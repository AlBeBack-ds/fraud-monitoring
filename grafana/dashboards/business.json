            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT\n  us_state AS \"Штат\",\n  count(*) AS \"Транзакций\",\n  sum(fraud_flag) AS \"Фрод\",\n  100.0 * avg(fraud_flag) AS \"Доля фрода, %\",\n  coalesce(sum(amount) FILTER (WHERE fraud_flag = 1), 0) AS \"Сумма фрода, $\"\nFROM fraud_scores\nWHERE $__timeFilter(created_at) AND ('__all' IN ($state) OR us_state IN ($state)) AND ('__all' IN ($merch) OR merch IN ($merch))\nGROUP BY us_state\nORDER BY 5 DESC, 2 DESC\nLIMIT 10",
