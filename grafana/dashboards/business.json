    {
      "type": "barchart",
      "title": "Доля фрода по размеру суммы",
      "description": "Свой график. Фрод сосредоточен в крупных платежах, поэтому порог ручной проверки разумно ставить по сумме: видно, начиная с какого размера платежа доля фрода резко растёт.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT\n  CASE\n    WHEN amount < 10 THEN '1. до $10'\n    WHEN amount < 50 THEN '2. $10–50'\n    WHEN amount < 200 THEN '3. $50–200'\n    WHEN amount < 1000 THEN '4. $200–1000'\n    ELSE '5. от $1000'\n  END AS \"Сумма\",\n  100.0 * avg(fraud_flag) AS \"Доля фрода, %\"\nFROM fraud_scores\nWHERE $__timeFilter(created_at) AND ('__all' IN ($state) OR us_state IN ($state)) AND ('__all' IN ($merch) OR merch IN ($merch)) AND amount IS NOT NULL\nGROUP BY 1\nORDER BY 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 1,
