    {
      "type": "barchart",
      "title": "Доля фрода по категориям, последние 1000 транзакций",
      "description": "Средняя доля транзакций с fraud_flag = 1 по cat_id среди 1000 последних записанных скоров. Фильтры дашборда сюда не применяются.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "WITH last_scores AS (\n  SELECT cat_id, fraud_flag\n  FROM fraud_scores\n  ORDER BY id DESC\n  LIMIT 1000\n)\nSELECT\n  cat_id AS \"Категория\",\n  100.0 * avg(fraud_flag) AS \"Доля фрода, %\"\nFROM last_scores\nGROUP BY cat_id\nORDER BY 2 DESC",
          "format": "table",
