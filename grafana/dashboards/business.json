    {
      "type": "barchart",
      "title": "Плотность распределения скоров",
      "description": "Доля транзакций выбранных штатов и мерчантов в каждом интервале скора шириной 0.05. Ось Y логарифмическая, иначе хвост с высокими скорами не виден рядом с массой около нуля.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT\n  to_char(least(floor(score * 20), 19) / 20.0, 'FM0.00') || '–' ||\n    to_char((least(floor(score * 20), 19) + 1) / 20.0, 'FM0.00') AS \"Скор\",\n  100.0 * count(*) / sum(count(*)) OVER () AS \"Доля транзакций, %\"\nFROM fraud_scores\nWHERE $__timeFilter(created_at) AND ('__all' IN ($state) OR us_state IN ($state)) AND ('__all' IN ($merch) OR merch IN ($merch))\nGROUP BY least(floor(score * 20), 19)\nORDER BY least(floor(score * 20), 19)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 1,
            "gradientMode": "none",
            "axisSoftMin": 0,
