      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT\n  $__timeGroupAlias(created_at, $__interval),\n  count(*) / ($__interval_ms / 1000.0) AS \"TPS\"\nFROM fraud_scores\nWHERE $__timeFilter(created_at) AND ('__all' IN ($state) OR us_state IN ($state)) AND ('__all' IN ($merch) OR merch IN ($merch))\nGROUP BY 1\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
