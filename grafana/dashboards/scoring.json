{
  "uid": "fraud-scoring",
  "title": "Скоринг транзакций",
  "description": "Обработка потока: скорость, время обработки, доля фрода, распределение скоров и смены модели.",
  "tags": [
    "fraud",
    "scoring"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "fraud"
      ],
      "asDropdown": false,
      "title": "Дашборды",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Смена модели",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "(fraud_scorer_model_switches_total unless fraud_scorer_model_switches_total offset 30s) or (increase(fraud_scorer_model_switches_total[30s]) > 0)",
        "step": "1s",
        "titleFormat": "Модель {{version}}",
        "textFormat": "Скоринг перешёл на версию {{version}}",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
