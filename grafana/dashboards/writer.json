    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Смена модели",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "(fraud_scorer_model_switches_total unless fraud_scorer_model_switches_total offset 30s) or (increase(fraud_scorer_model_switches_total[30s]) > 0)",
        "step": "1s",
        "titleFormat": "Модель {{version}}",
        "textFormat": "Скоринг перешёл на версию {{version}}",
        "useValueForTime": false
      }
    ]
