  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "fraud"
      ],
      "asDropdown": false,
      "title": "Дашборды",
      "includeVars": false,
      "keepTime": true
    }
  ],
