    {
      "type": "table",
      "title": "Скоры и доля фрода по версиям модели",
      "description": "Данные из таблицы fraud_scores: какая версия модели сколько транзакций отскорила и сколько из них пометила как фрод.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT\n  model_version AS \"Версия\",\n  count(*) AS \"Скоров\",\n  sum(fraud_flag) AS \"Фрод\",\n  round(100.0 * avg(fraud_flag), 3) AS \"Доля фрода, %\",\n  round(avg(score)::numeric, 4) AS \"Средний скор\",\n  min(created_at) AS \"Первый скор\",\n  max(created_at) AS \"Последний скор\"\nFROM fraud_scores\nGROUP BY model_version\nORDER BY min(created_at) DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Доля фрода, %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 5
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Версия"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 230
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 14,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Записано в PostgreSQL по версиям, в минуту",
      "description": "То же из базы: строки fraud_scores по минутам и версиям модели. Видно, когда новая версия начала писать скоры.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT\n  $__timeGroupAlias(created_at, '1m'),\n  model_version AS metric,\n  count(*) AS value\nFROM fraud_scores\nWHERE $__timeFilter(created_at)\nGROUP BY 1, 2\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
